;; -*- mode: lisp-data; coding: utf-8 -*-
;; Пилот: «Список очередей» и «Форма очереди» в виде графа.
;; Авторский файл: список узлов.  build-pilot.el добавляет служебные поля
;; (:status, :actual по умолчанию, :created …) и пишет sifox-cases.eld формата 2.
;;
;; Тестовые данные пилота (создаются кейсами по ходу графа):
;;   «Кредиты» - очередь без операторов                    (QFRM-022)
;;   «Вклады»  - очередь с одним оператором, приоритет 0   (QFRM-025)
;;   «Ипотека» - очередь с группой целиком, резервом «Вклады», праздничным
;;               днём и настройками не по умолчанию         (QFRM-026)
;;
;; Кейс, от которого зависят другие, - «шлюз»: действие и только тот результат,
;; который нужен детям.  Детали - шаги без When или отдельные кейсы-листья.
(
 ;; ===================================================================
 ;; Авторизация и выбор роли - заглушка пилота, модуль будет переписан
 ;; ===================================================================
 (:id "AUTH-001" :module "Авторизация и выбор роли"
  :title "Войти в кабинет руководителя"
  :access r :roles ("Руководитель") :parents nil :priority "1" :severity "S1 Блокирующий"
  :steps ((:when "Войти в АРМ учётной записью с ролью «Руководитель»"
           :then "Открыт кабинет руководителя")
          (:when "В шапке выбрать «Все мои направления»"
           :then "В шапке выбрано «Все мои направления»")))

 ;; ===================================================================
 ;; Список очередей
 ;; ===================================================================
 (:id "QUE-S01" :module "Список очередей" :setup t
  :title "Стенд: в направлениях руководителя нет ни одной очереди"
  :access r :roles ("Руководитель") :parents nil
  :steps ((:when "Подготовить стенд (или взять руководителя с новыми направлениями): ни активных, ни архивных очередей"
           :then "В направлениях руководителя нет ни одной очереди")))

 (:id "QUE-001" :module "Список очередей"
  :title "Открыть раздел «Очереди»"
  :access r :roles ("Руководитель") :parents ("AUTH-001") :priority "2" :severity "S2 Критический"
  :steps ((:when "Нажать пункт меню «Очереди»"
           :then "Открыт раздел с заголовком «ОЧЕРЕДИ»")
          (:then "Есть кнопка «+ Создать очередь»")
          (:then "Таблица с колонками «Очередь», «Операторы», «Группы», «Распределение», «Резерв», «Статус» и колонкой действий")))

 (:id "QUE-002" :module "Список очередей"
  :title "Пустое состояние списка очередей"
  :access r :roles ("Руководитель") :parents ("QUE-001" "QUE-S01") :priority "3" :severity "S3 Значительный"
  :steps ((:given "В направлениях руководителя нет ни одной очереди"
           :when "Осмотреть экран"
           :then "Строк в таблице нет")
          (:then "Отображается блок «В НАПРАВЛЕНИИ НЕТ ОЧЕРЕДЕЙ» с текстом «Создайте первую очередь и выберите для неё рабочий номер — входящие начнут распределяться по заданным правилам.» и кнопкой «Создать очередь»")
          (:when "Нажать «Создать очередь» в блоке пустого состояния"
           :then "Открывается форма «СОЗДАНИЕ ОЧЕРЕДИ»")))

 (:id "QUE-003" :module "Список очередей"
  :title "Перейти к созданию очереди"
  :access r :roles ("Руководитель") :parents ("QUE-001") :priority "1" :severity "S2 Критический"
  :steps ((:when "Нажать «+ Создать очередь»"
           :then "Открывается экран «СОЗДАНИЕ ОЧЕРЕДИ» с кнопкой «Назад»")
          (:then "В меню выделен пункт «Очереди»"))
  :actual ((:state ok :note "") (:state ok :note "")))

 (:id "QUE-004" :module "Список очередей"
  :title "Строки списка очередей"
  :access r :roles ("Руководитель") :parents ("QUE-001" "QFRM-022") :priority "2" :severity "S2 Критический"
  :steps ((:given "Создана хотя бы одна очередь, архивных очередей нет"
           :when "Открыть раздел «Очереди»"
           :then "Строки таблицы — все активные очереди направлений руководителя")
          (:then "Кнопки «Показать архив» нет")))

 (:id "QUE-005" :module "Список очередей"
  :title "Строка работающей очереди"
  :access r :roles ("Руководитель") :parents ("QUE-004" "QFRM-026" "QFRM-S05") :priority "3" :severity "S2 Критический"
  :steps ((:given "Текущее время — в рабочих часах очереди «Ипотека»"
           :when "Осмотреть строку очереди «Ипотека»"
           :then "Показаны название очереди, её рабочий номер и направление")
          (:then "Операторы — число операторов очереди")
          (:then "Группы — «<группа> (<число операторов группы>)»")
          (:then "Распределение — стратегия очереди и «приоритет <приоритет очереди>»")
          (:then "Резерв — название резервной очереди («Вклады»)")
          (:then "Статус — зелёная метка «Работает»")
          (:then "Действия: «Клонировать…», «Редактировать», «Архивировать очередь»")))

 (:id "QUE-006" :module "Список очередей"
  :title "Строка очереди вне рабочего времени"
  :access r :roles ("Руководитель") :parents ("QUE-004" "QFRM-033") :priority "3" :severity "S2 Критический"
  :steps ((:given "Текущее время — до начала рабочих часов очереди «Кредиты»"
           :when "Осмотреть строку очереди «Кредиты»"
           :then "Строка полупрозрачная")
          (:then "Операторы, Группы, Распределение и Резерв соответствуют настройкам очереди")
          (:then "Статус — серая метка «Не работает до <время начала работы очереди>»")))

 (:id "QUE-007" :module "Список очередей"
  :title "Открыть очередь на редактирование кликом по строке"
  :access r :roles ("Руководитель") :parents ("QUE-004") :priority "1" :severity "S2 Критический"
  :steps ((:when "Нажать на строку любой очереди (вне кнопок действий)"
           :then "Открывается экран «РЕДАКТИРОВАНИЕ ОЧЕРЕДИ» с данными выбранной очереди и кнопкой «Назад»"))
  :actual ((:state ok :note "")))

 (:id "QUE-008" :module "Список очередей"
  :title "Клонировать очередь"
  :access w :roles ("Руководитель") :parents ("QUE-004" "QFRM-026") :priority "1" :severity "S2 Критический"
  :steps ((:when "Навести на первую иконку в строке очереди «Ипотека»"
           :then "Подсказка «Клонировать — создать новую очередь с такими же настройками»")
          (:when "Нажать эту иконку"
           :then "Открывается «СОЗДАНИЕ ОЧЕРЕДИ» с текстом «Настройки скопированы из очереди «Ипотека». Укажите название и рабочий номер.»")
          (:then "Название пустое, номер — «Выберите номер»")
          (:then "Приоритет, стратегия, лимит каналов, резервная очередь и блок группы (с числом операторов) — как у очереди «Ипотека»")
          (:then "Отмеченные праздничные дни («Отмечено: <N>») — как у очереди «Ипотека»"))
  :actual ((:state ok :note "") (:state ok :note "") (:state ok :note "")
           (:state ok :note "") (:state ok :note "")))

 (:id "QUE-009" :module "Список очередей"
  :title "Архивирование очереди: окно подтверждения"
  :access x :roles ("Руководитель") :parents ("QUE-004" "QFRM-026") :priority "1" :severity "S2 Критический"
  :steps ((:given "Очередь «Вклады» с оператором является резервной для очереди «Ипотека»"
           :when "Нажать иконку «Архивировать очередь» в строке очереди «Вклады»"
           :then "Открывается модальное окно «АРХИВИРОВАТЬ ОЧЕРЕДЬ «ВКЛАДЫ»?»")
          (:then "Текст окна: «Очередь перестанет принимать вызовы на номер <рабочий номер очереди>. Операторы (<число операторов очереди>) будут отвязаны от очереди. Она резервная для «Ипотека» — там резерв сбросится. История звонков и отчёты сохранятся. Очередь можно восстановить из архива.»")
          (:then "Кнопки «Отмена» и «Архивировать» (красная)"))
  :actual ((:state fail :note "Нет иконки архивировать очередь в списке очередей.")
           (:state todo :note "") (:state todo :note "")))

 (:id "QUE-010" :module "Список очередей"
  :title "Архивировать очередь"
  :access x :roles ("Руководитель") :parents ("QUE-009") :priority "1" :severity "S2 Критический"
  :steps ((:given "Архивных очередей нет"
           :when "В окне подтверждения нажать «Архивировать»"
           :then "Тост типа «ОЧЕРЕДИ» с заголовком «Очередь в архиве» и текстом ««Вклады» больше не принимает вызовы.»")
          (:then "Очередь «Вклады» исчезает из списка")
          (:then "У очереди «Ипотека» резерв — «—»")
          (:then "Появляется кнопка «Показать архив (1)»")
          (:when "Открыть «Дашборд» и раскрыть фильтр очередей"
           :then "Очереди «Вклады» в фильтре очередей дашборда нет")))

 (:id "QUE-011" :module "Список очередей"
  :title "Показать архивные очереди"
  :access r :roles ("Руководитель") :parents ("QUE-010") :priority "2" :severity "S2 Критический"
  :steps ((:given "Есть архивная очередь, показ архива выключен"
           :when "Нажать «Показать архив (<N>)»"
           :then "Кнопка меняется на «Скрыть архив (<N>)», где N — число архивных очередей")
          (:then "В списке появляются полупрозрачные строки архивных очередей с серой меткой «Архив»")
          (:then "Вместо иконки архивирования — иконка «Восстановить из архива»")))

 (:id "QUE-012" :module "Список очередей"
  :title "Восстановить очередь из архива"
  :access x :roles ("Руководитель") :parents ("QUE-011" "QFRM-S05") :priority "2" :severity "S2 Критический"
  :steps ((:given "В архиве ровно одна очередь — «Вклады»; текущее время — в её рабочих часах; показ архива включён"
           :when "Нажать «Восстановить из архива» в строке архивной очереди"
           :then "Окно «ВОССТАНОВИТЬ ОЧЕРЕДЬ «ВКЛАДЫ»?» с текстом «Очередь снова начнёт принимать вызовы. Назначения операторов вернутся — их можно изменить в настройках очереди.» и синей кнопкой «Восстановить»")
          (:when "Нажать «Восстановить»"
           :then "Очередь «Вклады» в списке со статусом «Работает»")
          (:then "Число операторов очереди — как до архивирования")
          (:then "Кнопка «Показать/Скрыть архив» исчезает")))

 ;; ===================================================================
 ;; Форма очереди
 ;; ===================================================================
 (:id "QFRM-S01" :module "Форма очереди" :setup t
  :title "Стенд: есть минимум три свободных рабочих номера"
  :access r :roles ("Руководитель") :parents nil
  :steps ((:when "Проверить на стенде рабочие номера (FTN) направления"
           :then "Свободных рабочих номеров не меньше трёх")))

 (:id "QFRM-S02" :module "Форма очереди" :setup t
  :title "Стенд: в направлении есть группа с операторами и ещё два оператора"
  :access r :roles ("Руководитель") :parents nil
  :steps ((:when "Проверить на стенде группы и операторов первого направления руководителя (после переписывания модуля «Группы и операторы» этот узел заменят его кейсы)"
           :then "В направлении есть группа с операторами и минимум два оператора для добавления по одному")))

 (:id "QFRM-S03" :module "Форма очереди" :setup t
  :title "Стенд: руководителю назначено два направления с группой и очередью в каждом"
  :access r :roles ("Руководитель") :parents nil
  :steps ((:when "Проверить на стенде направления руководителя"
           :then "Руководителю назначено минимум два направления; в каждом из направлений 1 и 2 есть группа с операторами и очередь")))

 (:id "QFRM-S04" :module "Форма очереди" :setup t
  :title "Стенд: свободных рабочих номеров нет"
  :access r :roles ("Руководитель") :parents nil
  :steps ((:when "Подготовить стенд: все рабочие номера закреплены за очередями"
           :then "Свободных рабочих номеров нет")))

 (:id "QFRM-S05" :module "Форма очереди" :setup t
  :title "Условие: будний день, 09:00–20:00"
  :access r :roles ("Руководитель") :parents nil
  :steps ((:when "Выполнять зависящие от этого узла кейсы в рабочие часы по умолчанию"
           :then "Сейчас будний день, время между 09:00 и 20:00")))

 (:id "QFRM-001" :module "Форма очереди"
  :title "Структура формы создания очереди"
  :access r :roles ("Руководитель") :parents ("QUE-003") :priority "2" :severity "S2 Критический"
  :steps ((:when "Осмотреть экран"
           :then "Заголовок «СОЗДАНИЕ ОЧЕРЕДИ» с кнопкой «Назад»")
          (:then "Секции «ОСНОВНОЕ», «ОПЕРАТОРЫ ОЧЕРЕДИ», «РАСПРЕДЕЛЕНИЕ И ЛИМИТЫ», «РАБОЧЕЕ ВРЕМЯ И КАЛЕНДАРЬ», «ПЕРЕПОЛНЕНИЕ И ОЖИДАНИЕ»")
          (:then "Внизу кнопки «Отмена» и «Создать очередь»")))

 (:id "QFRM-002" :module "Форма очереди"
  :title "Значения по умолчанию: секция «Основное»"
  :access r :roles ("Руководитель") :parents ("QFRM-001") :priority "2" :severity "S2 Критический"
  :steps ((:when "Осмотреть секцию «Основное»"
           :then "Плашка «Можно скопировать все настройки существующей очереди — кроме названия и рабочего номера.» со списком «Скопировать настройки из очереди…»")
          (:then "Поле «Название *» пустое с подсказкой «Например, «Кредиты»»")
          (:then "«Направление *» — первое из направлений руководителя")
          (:then "«Рабочий номер (FTN) *» — «Выберите номер»")
          (:then "«Приоритет *» — 1 с пояснением «Целое число: чем больше, тем выше»")))

 (:id "QFRM-003" :module "Форма очереди"
  :title "Значения по умолчанию: секция «Распределение и лимиты»"
  :access r :roles ("Руководитель") :parents ("QFRM-001") :priority "2" :severity "S2 Критический"
  :steps ((:when "Осмотреть секцию «Распределение и лимиты»"
           :then "Карточка «По кругу · по умолчанию» выбрана, текст «Вызовы распределяются по очереди между всеми операторами.»")
          (:then "Карточка «Первый освободившийся» — «Вызов получает первый свободный оператор по порядку списка.»")
          (:then "Карточка «Дольше всего свободный» — «Вызов получает оператор, который дольше всех ждёт вызова.»")
          (:then "«Ожидание ответа оператора, сек *» — 20")
          (:then "«Максимальное ожидание клиента, мин *» — 5")
          (:then "«Лимит каналов очереди *» — 5")))

 (:id "QFRM-004" :module "Форма очереди"
  :title "Отмена формы без изменений"
  :access r :roles ("Руководитель") :parents ("QFRM-001") :priority "3" :severity "S3 Значительный"
  :steps ((:when "Ничего не меняя, нажать «Отмена»"
           :then "Окно о несохранённых изменениях не показывается")
          (:then "Открывается раздел «Очереди»")))

 (:id "QFRM-005" :module "Форма очереди"
  :title "Список рабочих номеров: занятые и свободные"
  :access r :roles ("Руководитель") :parents ("QFRM-001" "QFRM-022" "QFRM-S01") :priority "2" :severity "S2 Критический"
  :steps ((:given "Есть рабочие номера, закреплённые за очередями, и минимум один свободный"
           :when "Раскрыть список «Рабочий номер (FTN) *»"
           :then "Номера, закреплённые за очередями, неактивны и подписаны «<номер> — закреплён за очередью «<очередь>»»")
          (:then "Свободные номера доступны с подписью «<номер> — свободен»")))

 (:id "QFRM-006" :module "Форма очереди"
  :title "Список рабочих номеров: свободных нет"
  :access r :roles ("Руководитель") :parents ("QFRM-001" "QFRM-S04") :priority "2" :severity "S2 Критический"
  :steps ((:given "Все рабочие номера закреплены за очередями"
           :when "Раскрыть список «Рабочий номер (FTN) *»"
           :then "Все номера в списке неактивны")
          (:then "Под полем жёлтая плашка «Свободных номеров нет.»")))

 (:id "QFRM-007" :module "Форма очереди"
  :title "Выбрать стратегию распределения"
  :access w :roles ("Руководитель") :parents ("QFRM-003") :priority "2" :severity "S3 Значительный"
  :steps ((:when "Нажать карточку «Первый освободившийся»"
           :then "Карточка «Первый освободившийся» выделяется: синяя рамка, отмеченная радиокнопка")
          (:then "Выделение с карточки «По кругу · по умолчанию» снимается")))

 (:id "QFRM-008" :module "Форма очереди"
  :title "Включить рабочий день недели"
  :access w :roles ("Руководитель") :parents ("QFRM-001") :priority "2" :severity "S3 Значительный"
  :steps ((:when "Нажать кнопку «Сб»"
           :then "«Сб» становится синей (подсказка «Рабочий день»)")
          (:then "Подпись — «Выходные: Вс»")
          (:then "В календаре субботы перестают быть серыми")))

 (:id "QFRM-009" :module "Форма очереди"
  :title "Отключить все рабочие дни"
  :access w :roles ("Руководитель") :parents ("QFRM-001") :priority "2" :severity "S3 Значительный"
  :steps ((:given "Рабочие дни по умолчанию: «Пн»–«Пт»"
           :when "Отключить «Пн», «Вт», «Ср», «Чт», «Пт»"
           :then "Подпись — «Нет рабочих дней — очередь не будет работать»")
          (:then "Все дни календаря серые")))

 (:id "QFRM-010" :module "Форма очереди"
  :title "Отметить и снять праздничный день"
  :access w :roles ("Руководитель") :parents ("QFRM-001") :priority "3" :severity "S3 Значительный"
  :steps ((:when "Нажать на любой рабочий день в календаре"
           :then "День выделен красным, подпись «…Отмечено: 1»")
          (:when "Повторно нажать на этот же день"
           :then "Отметка снимается, подпись «…Отмечено: 0»")))

 (:id "QFRM-011" :module "Форма очереди"
  :title "Валидация: название очереди обязательно"
  :access w :roles ("Руководитель") :parents ("QFRM-001" "QFRM-S01") :priority "1" :severity "S2 Критический"
  :steps ((:when "Оставить «Название *» пустым, выбрать любой свободный рабочий номер и нажать «Создать очередь»"
           :then "Очередь не создаётся")
          (:then "Под полем названия красный текст «Укажите название очереди»"))
  :actual ((:state ok :note "") (:state ok :note "")))

 (:id "QFRM-012" :module "Форма очереди"
  :title "Валидация: рабочий номер обязателен"
  :access w :roles ("Руководитель") :parents ("QFRM-001") :priority "1" :severity "S2 Критический"
  :steps ((:when "Ввести название «Кредиты», номер не выбирать и нажать «Создать очередь»"
           :then "Очередь не создаётся")
          (:then "Под полем номера ошибка «Выберите рабочий номер»"))
  :actual ((:state ok :note "") (:state ok :note "")))

 (:id "QFRM-013" :module "Форма очереди"
  :title "Валидация: недопустимые значения приоритета"
  :access w :roles ("Руководитель") :parents ("QFRM-001" "QFRM-S01") :priority "1" :severity "S2 Критический"
  :steps ((:when "Заполнить название и номер, ввести в «Приоритет *» значение «-1» и нажать «Создать очередь»"
           :then "Ошибка «Приоритет — целое неотрицательное число», очередь не создаётся")
          (:when "Ввести в «Приоритет *» значение «1.5» и нажать «Создать очередь»"
           :then "Ошибка «Приоритет — целое неотрицательное число», очередь не создаётся")
          (:when "Ввести в «Приоритет *» значение «abc» и нажать «Создать очередь»"
           :then "Ошибка «Приоритет — целое неотрицательное число», очередь не создаётся")
          (:when "Очистить «Приоритет *» и нажать «Создать очередь»"
           :then "Ошибка «Приоритет — целое неотрицательное число», очередь не создаётся"))
  :actual ((:state ok :note "") (:state ok :note "") (:state ok :note "") (:state ok :note "")))

 (:id "QFRM-014" :module "Форма очереди"
  :title "Валидация: время окончания работы раньше начала"
  :access w :roles ("Руководитель") :parents ("QFRM-001" "QFRM-S01") :priority "1" :severity "S2 Критический"
  :steps ((:when "Заполнить название и номер, задать часы работы 20:00 — 09:00 и нажать «Создать очередь»"
           :then "Под часами работы ошибка «Время окончания должно быть позже начала», очередь не создаётся")
          (:when "Задать часы работы 10:00 — 10:00 и нажать «Создать очередь»"
           :then "Под часами работы ошибка «Время окончания должно быть позже начала», очередь не создаётся"))
  :actual ((:state ok :note "") (:state ok :note "")))

 (:id "QFRM-015" :module "Форма очереди"
  :title "Подсветка полей с ошибкой"
  :access w :roles ("Руководитель") :parents ("QFRM-001") :priority "3" :severity "S4 Незначительный"
  :steps ((:when "Оставить «Название *» пустым, номер не выбирать и нажать «Создать очередь»"
           :then "Под полями ошибки «Укажите название очереди» и «Выберите рабочий номер»")
          (:then "Рамка поля «Название *» красная")
          (:then "Рамка списка «Рабочий номер (FTN) *» красная"))
  :actual ((:state ok :note "")
           (:state fail :note "Рамки ввода полей не окрашиваются в красный")
           (:state fail :note "Рамки ввода полей не окрашиваются в красный")))

 (:id "QFRM-016" :module "Форма очереди"
  :title "Сохранение из окна несохранённых изменений при ошибках валидации"
  :access w :roles ("Руководитель") :parents ("QFRM-001") :priority "2" :severity "S3 Значительный"
  :steps ((:when "Изменить приоритет на 3, название оставить пустым и нажать «Отмена» внизу формы"
           :then "Окно с текстом «Изменения в очереди «Новая очередь» не сохранены. Сохранить перед выходом?»")
          (:when "В окне нажать «Сохранить»"
           :then "Окно закрывается, форма остаётся открытой")
          (:then "В форме ошибки «Укажите название очереди» и «Выберите рабочий номер»")))

 (:id "QFRM-017" :module "Форма очереди"
  :title "Добавить оператора отдельно"
  :access w :roles ("Руководитель") :parents ("QFRM-001" "QFRM-S02") :priority "1" :severity "S2 Критический"
  :steps ((:when "В списке «+ Добавить оператора» выбрать любого оператора («<ФИО> · <группа>»)"
           :then "Появляется блок «Добавлены отдельно» — «1 опер.» со строкой «1 <ФИО> · <группа>» и кнопками ↑ ↓ ✕")
          (:then "Оператор пропадает из списка добавления"))
  :actual ((:state ok :note "") (:state ok :note "")))

 (:id "QFRM-018" :module "Форма очереди"
  :title "Убрать отдельно добавленного оператора"
  :access w :roles ("Руководитель") :parents ("QFRM-017") :priority "1" :severity "S2 Критический"
  :steps ((:given "Отдельно добавлен один оператор"
           :when "Нажать ✕ (подсказка «Убрать») в строке оператора"
           :then "Оператор удаляется из очереди, блок «Добавлены отдельно» исчезает")
          (:then "Оператор снова доступен в списке добавления"))
  :actual ((:state ok :note "") (:state ok :note "")))

 (:id "QFRM-019" :module "Форма очереди"
  :title "Изменить порядок операторов"
  :access w :roles ("Руководитель") :parents ("QFRM-017") :priority "3" :severity "S3 Значительный"
  :steps ((:given "Отдельно добавлен оператор 1"
           :when "Добавить отдельно оператора 2 и нажать ↓ (подсказка «Ниже») у оператора 1"
           :then "Порядок: 1 — оператор 2, 2 — оператор 1")
          (:when "Нажать ↑ (подсказка «Выше») у первой строки"
           :then "Порядок не меняется")))

 (:id "QFRM-020" :module "Форма очереди"
  :title "Добавить группу целиком"
  :access w :roles ("Руководитель") :parents ("QFRM-001" "QFRM-S02") :priority "1" :severity "S2 Критический"
  :steps ((:when "В списке «+ Добавить группу целиком» выбрать любую группу («<группа> · <N> опер.»)"
           :then "Появляется блок с иконкой группы: «<группа>», «Группа целиком · <N> опер. · новые операторы группы попадут в очередь автоматически», кнопка «Убрать группу»")
          (:then "В блоке N строк операторов группы с номерами 1–N и кнопками ↑ ↓ без ✕")
          (:then "Плашка «Очередь без операторов…» скрывается")
          (:then "В списке групп вариант становится неактивным: «<группа> · <N> опер. — уже добавлена»"))
  :actual ((:state ok :note "") (:state ok :note "") (:state ok :note "") (:state ok :note "")))

 (:id "QFRM-021" :module "Форма очереди"
  :title "Смена направления сбрасывает операторов и резерв"
  :access w :roles ("Руководитель") :parents ("QFRM-001" "QFRM-S03") :priority "2" :severity "S3 Значительный"
  :steps ((:given "В поле «Направление *» — направление 1"
           :when "Добавить группу целиком, выбрать резервную очередь, затем в поле «Направление *» выбрать направление 2"
           :then "Операторы и группы удаляются, показана плашка «Очередь без операторов…»")
          (:then "Резерв — «Не задана»")
          (:then "В списке групп — только группы направления 2")
          (:then "В списке резервных очередей — только очереди направления 2")))

 (:id "QFRM-022" :module "Форма очереди"
  :title "Создать очередь без операторов"
  :access w :roles ("Руководитель") :parents ("QFRM-001" "QFRM-S01" "QFRM-S05") :priority "1" :severity "S2 Критический"
  :steps ((:when "Ввести название «Кредиты», выбрать любой свободный рабочий номер, операторов не добавлять и нажать «Создать очередь»; если открылось окно «Очередь без операторов» — нажать в нём «Сохранить»"
           :then "Открывается раздел «Очереди», в списке есть строка «Кредиты»")
          (:then "Тост «ОЧЕРЕДЬ СОЗДАНА» — «Кредиты» — работает» с текстом «Входящие на <выбранный рабочий номер> распределяются по стратегии «По кругу».»")
          (:then "В строке «Кредиты» — выбранный рабочий номер и направление из формы")
          (:given "Текущее время — в рабочих часах по умолчанию (будний день, 09:00–20:00)"
           :then "В строке: Операторы «Нет» (жёлто-коричневым), Группы «—», «По кругу», «приоритет 1», резерв «—», статус «Работает»"))
  :actual ((:state ok :note "") (:state todo :note "") (:state todo :note "") (:state todo :note "")))

 (:id "QFRM-023" :module "Форма очереди"
  :title "Плашка об очереди без операторов"
  :access w :roles ("Руководитель") :parents ("QFRM-001" "QFRM-S01") :priority "1" :severity "S3 Значительный"
  :steps ((:when "Ввести название «Без операторов», выбрать любой свободный рабочий номер, операторов не добавлять"
           :then "Под блоком операторов жёлтая плашка «Очередь без операторов: все вызовы будут уходить в обратный звонок.»")))

 (:id "QFRM-024" :module "Форма очереди"
  :title "Окно подтверждения очереди без операторов"
  :access w :roles ("Руководитель") :parents ("QFRM-023") :priority "1" :severity "S2 Критический"
  :steps ((:when "Нажать «Создать очередь»"
           :then "Открывается окно «ОЧЕРЕДЬ БЕЗ ОПЕРАТОРОВ»")
          (:then "Текст окна: «Все вызовы на рабочий номер будут уходить в обратный звонок. Сохранить всё равно?»")
          (:then "Кнопки «Отмена» и «Сохранить»"))
  :actual ((:state fail :note "Окно не было отображено.\nПодтверждения о создании очереди без операторов не было.\nОчередь создана без подтверждения.")
           (:state todo :note "") (:state todo :note "")))

 (:id "QFRM-025" :module "Форма очереди"
  :title "Создать очередь с приоритетом 0"
  :access w :roles ("Руководитель") :parents ("QFRM-017" "QFRM-S01") :priority "3" :severity "S3 Значительный"
  :steps ((:given "В форме отдельно добавлен оператор"
           :when "Ввести название «Вклады», выбрать любой свободный рабочий номер, ввести приоритет 0 и нажать «Создать очередь»"
           :then "Ошибки приоритета нет, очередь создаётся")
          (:then "В списке «Очереди» у очереди «Вклады» — «приоритет 0»")))

 (:id "QFRM-026" :module "Форма очереди"
  :title "Создать очередь с группой, резервом и праздничным днём"
  :access w :roles ("Руководитель") :parents ("QFRM-025" "QFRM-S02" "QFRM-S01") :priority "1" :severity "S2 Критический"
  :steps ((:given "Есть очередь «Вклады»"
           :when "Нажать «+ Создать очередь» и в форме: название «Ипотека», свободный рабочий номер, стратегия «Первый освободившийся», приоритет 2, лимит каналов 7, другая музыка ожидания; добавить группу целиком; резервная очередь — «Вклады»; отметить один праздничный день; нажать «Создать очередь»"
           :then "Открывается раздел «Очереди», в списке есть строка «Ипотека»")))

 (:id "QFRM-027" :module "Форма очереди"
  :title "Скопировать настройки существующей очереди"
  :access w :roles ("Руководитель") :parents ("QFRM-001" "QFRM-026") :priority "2" :severity "S2 Критический"
  :steps ((:given "Настройки очереди «Ипотека» отличаются от значений по умолчанию"
           :when "Ввести название «Тест» и в списке «Скопировать настройки из очереди…» выбрать «Ипотека · <рабочий номер>»"
           :then "Тост «Настройки скопированы из «Ипотека»» с текстом «Стратегия, лимиты, рабочее время, резерв, callback, CSAT и операторы перенесены. Укажите название и рабочий номер.»")
          (:then "Плашка меняется на «Настройки скопированы из очереди «Ипотека». Укажите название и рабочий номер.»")
          (:then "Название «Тест» сохранено, рабочий номер не скопирован")
          (:then "Направление, стратегия, приоритет, лимит каналов, музыка ожидания и блок группы (с числом операторов) — как у очереди «Ипотека»")))

 (:id "QFRM-028" :module "Форма очереди"
  :title "Данные очереди в форме редактирования"
  :access r :roles ("Руководитель") :parents ("QUE-007" "QFRM-026") :priority "1" :severity "S2 Критический"
  :steps ((:given "Кликом по строке открыта очередь «Ипотека»"
           :when "Осмотреть форму"
           :then "Заголовок «РЕДАКТИРОВАНИЕ ОЧЕРЕДИ», плашки копирования нет")
          (:then "Рабочий номер только для чтения (замок)")
          (:then "Название, приоритет, стратегия, таймеры и лимит каналов, часы работы соответствуют сохранённым настройкам очереди")
          (:then "Праздничные дни отмечены красным, подпись «Отмечено: <N>»")
          (:then "Резервная очередь и блок группы (с числом операторов) соответствуют сохранённым настройкам")
          (:then "Есть кнопка «Сохранить»"))
  :actual ((:state ok :note "") (:state ok :note "") (:state ok :note "")
           (:state ok :note "") (:state ok :note "") (:state ok :note "")))

 (:id "QFRM-029" :module "Форма очереди"
  :title "Сохранить изменения очереди"
  :access w :roles ("Руководитель") :parents ("QFRM-028") :priority "1" :severity "S2 Критический"
  :steps ((:given "Текущий приоритет очереди запомнен"
           :when "Изменить приоритет на другое допустимое значение (например, на 1 больше текущего) и нажать «Сохранить»"
           :then "Открывается раздел «Очереди»")
          (:then "Тост «ОЧЕРЕДЬ СОХРАНЕНА» — «Параметры «<название очереди>» обновлены» с текстом «Изменения применяются к новым вызовам. Значения до/после записаны в журнал аудита.»")
          (:then "В строке очереди — «приоритет <новое значение>»")
          (:when "Открыть «Журнал аудита»"
           :then "Новая запись «Изменение очереди»: «Приоритет <прежнее значение>» → «Приоритет <новое значение>»"))
  :actual ((:state ok :note "") (:state ok :note "") (:state ok :note "") (:state ok :note "")))

 (:id "QFRM-030" :module "Форма очереди"
  :title "Предупреждение при уходе с изменённой формы"
  :access w :roles ("Руководитель") :parents ("QFRM-028") :priority "2" :severity "S2 Критический"
  :steps ((:when "Изменить название очереди (например, дописать « 2») и нажать пункт меню «Дашборд»"
           :then "Переход не выполняется, открывается окно «ЕСТЬ НЕСОХРАНЁННЫЕ ИЗМЕНЕНИЯ»")
          (:then "Текст окна: «Изменения в очереди «<изменённое название>» не сохранены. Сохранить перед выходом?»")
          (:then "Кнопки «Отмена», «Выйти без сохранения» (красная), «Сохранить»")))

 (:id "QFRM-031" :module "Форма очереди"
  :title "Выйти с формы без сохранения"
  :access w :roles ("Руководитель") :parents ("QFRM-030") :priority "2" :severity "S2 Критический"
  :steps ((:given "Название очереди изменено, открыто окно «Есть несохранённые изменения»"
           :when "Нажать «Выйти без сохранения»"
           :then "Открывается «Оперативный дашборд»")
          (:when "Открыть раздел «Очереди»"
           :then "Очередь называется прежним названием")))

 (:id "QFRM-032" :module "Форма очереди"
  :title "Сохранить из окна несохранённых изменений"
  :access w :roles ("Руководитель") :parents ("QFRM-028" "QFRM-030") :priority "2" :severity "S2 Критический"
  :steps ((:when "Изменить приоритет, нажать пункт меню «Дашборд» и в окне «Есть несохранённые изменения» нажать «Сохранить»"
           :then "Изменения сохраняются: тост «Параметры «<название очереди>» обновлены»")
          (:then "Открывается выбранный раздел «Оперативный дашборд»")))

 (:id "QFRM-033" :module "Форма очереди"
  :title "Сдвинуть начало рабочих часов очереди"
  :access w :roles ("Руководитель") :parents ("QUE-007" "QFRM-022") :priority "3" :severity "S3 Значительный"
  :steps ((:given "Кликом по строке открыта очередь «Кредиты»"
           :when "Задать начало рабочих часов позже текущего времени и нажать «Сохранить»"
           :then "Открывается раздел «Очереди»")))
)

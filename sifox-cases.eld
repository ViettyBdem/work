            (:n 2 :name "Инструкция по выдаче доступа к микрофону" :pre nil :steps
                ("Кликнуть по плашке «Нет доступа к микрофону»") :expected
                "В меню: «Браузер заблокировал микрофон»; «Звонки недоступны, пока сайт не получит доступ к микрофону.»; нумерованные шаги 1 «Нажмите на значок доступа слева в адресной строке», 2 «Разрешите использовать микрофон для этого сайта», 3 «Вернитесь сюда и повторите проверку»; кнопка «Разрешить и проверить»; текст «Если доступ разрешён, а звонки не работают, обратитесь к техническому администратору.»")
            (:n 3 :name "Повторная проверка без выданного доступа" :pre
                "Меню телефонии открыто." :steps
                ("Нажать «Разрешить и проверить»" "Дождаться завершения проверки.")
                :expected
                "Сначала отображается «Проверяем соединение», затем снова «Нет доступа к микрофону»; кнопка «Позвонить» не появляется.")
            (:n 4 :name "Повторная проверка после выдачи доступа" :pre
                "Затем доступ к микрофону для сайта АРМ разрешён в настройках браузера. Меню телефонии открыто."
                :steps ("Нажать «Разрешить и проверить»" "Дождаться завершения проверки.")
                :expected

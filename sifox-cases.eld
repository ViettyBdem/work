            (:n 3 :name "Подтверждение без причины" :pre nil :steps
                ("Открыть раздел «Пользователи» и кликнуть строку любого пользователя в статусе «Активен»"
                 "«Изменить статус» → «Заблокировать»"
                 "Оставить причину пустой, кликнуть кнопку подтверждения «Заблокировать»")

          ("TASK-004" :id "TASK-004" :module "Обратные звонки" :screen "Закрытие задачи"
           :title "Окно закрытия задачи: поля и валидация" :priority "High" :kind
           "Отображение" :mode chain :pre
           "Оператор авторизован, открыт раздел «Обратные звонки», у оператора есть открытые задачи callback."
           :parts
           ((:n 1 :name "Открытие окна закрытия задачи" :pre nil :steps
                ("Нажать «Закрыть задачу» в строке любой задачи.") :expected
                "Модальное окно «Закрытие задачи» с подзаголовком «<номер клиента>»; поле «Причина закрытия *» («Выберите причину»), поле «Комментарий *» с подсказкой «Опишите, почему задача закрывается без обратного звонка»; кнопки «Отмена» и «Закрыть задачу».")
            (:n 2 :name "Варианты причины закрытия" :pre "Открыто окно «Закрытие задачи»."
                :steps ("Раскрыть список «Причина закрытия *»") :expected
                "Варианты: «Выберите причину», «Клиент решил вопрос», «Дозвонились, callback не нужен», «Клиент отказался от обращения», «Ошибочный номер», «Передано другому оператору», «Лимит попыток исчерпан».")
            (:n 3 :name "Закрытие задачи без причины и комментария" :pre
                "Открыто окно «Закрытие задачи»." :steps
                ("Нажать «Закрыть задачу» в окне.") :expected
                "Окно не закрывается; красный блок «Выберите причину закрытия задачи.»")
            (:n 4 :name "Комментарий без причины" :pre "Открыто окно «Закрытие задачи»."
                :steps
                ("Ввести комментарий «Клиент перезвонил сам»"
                 "Нажать «Закрыть задачу» в окне.")
                :expected
                "Ошибка «Выберите причину закрытия задачи.»; окно не закрывается.")
            (:n 5 :name "Закрытие задачи без комментария" :pre
                "Открыто окно «Закрытие задачи»." :steps
                ("Выбрать причину «Клиент решил вопрос»" "Нажать «Закрыть задачу» в окне.")
                :expected
                "Окно не закрывается; ошибка «Комментарий обязателен: тимлид видит его в отчёте по задачам.»")
            (:n 6 :name "Комментарий из одних пробелов" :pre
                "Открыто окно «Закрытие задачи», выбрана причина «Ошибочный номер»."
                :steps
                ("Ввести в комментарий три пробела" "Нажать «Закрыть задачу» в окне.")
                :expected
                "Ошибка «Комментарий обязателен: тимлид видит его в отчёте по задачам.»; задача не закрыта."))

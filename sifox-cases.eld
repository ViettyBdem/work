          ("NAV-001" :id "NAV-001" :module "Каркас кабинета и навигация" :screen "Шапка"
           :title "Состав бокового меню и шапки кабинета" :priority "High" :kind
           "Отображение" :mode param :pre "" :parts
           ((:n 1 :name "Отображение блока пользователя в шапке" :pre
                "Пользователь с ролью «Технический администратор» вошёл в кабинет тех.админа. Есть непрочитанные уведомления."

          ("RTC-003" :id "RTC-003" :module "Телефония в браузере (WebRTC) и устройства"
           :screen "Потеря связи" :title
           "Потеря связи с телефонией: состояние, меню, индикатор, переподключение"
           :priority "High" :kind "Отображение" :mode chain :pre
           "Оператор авторизован (экран входа → «Войти»), открыт раздел «Личный кабинет», нет звонка, телефония в состоянии «Телефон подключён». Связь с телефонной платформой потеряна (регистрация в телефонии прервана)."
           :parts
           ((:n 1 :name "Состояние «Соединение восстанавливается»" :pre nil :steps
                ("Осмотреть блок статуса.") :expected
                "Плашка «Соединение восстанавливается» в жёлтой (предупреждающей) цветовой схеме; кнопка «Позвонить» не отображается.")
            (:n 2 :name "Содержимое меню при потере связи" :pre nil :steps
                ("Кликнуть по плашке «Соединение восстанавливается»") :expected
                "В меню: «Связь с телефонией потеряна»; «Идёт повторная регистрация в телефонии. Новые звонки временно не поступают, текущий разговор может прерваться.»; спиннер «Переподключаемся…»; кнопка «Переподключиться сейчас»; текст «Если связь не восстановилась за минуту, обратитесь к техническому администратору.»")
            (:n 3 :name "Индикатор телефонии в шапке гаснет при потере регистрации" :pre
                nil :steps ("Осмотреть шапку кабинета.") :expected
                "Индикатор состояния телефонии в шапке погашен.")
            (:n 4 :name "Ручное переподключение, пока связь не восстановлена" :pre

          ("AUTH-004" :id "AUTH-004" :module "Авторизация и выбор роли" :screen
           "Экран входа" :title
           "Вход с одной ролью: кабинет открывается сразу, смена роли не предлагается"
           :priority "High" :kind "Функциональный" :mode chain :pre
           "Пользователь не авторизован, открыт экран входа. Учётной записи назначена одна роль. Данные: 1) «Руководитель»; 2) «Оператор»."
           :parts
           ((:n 1 :name
                "Вход учётной записью с одной ролью открывает кабинет роли без выбора роли"
                :pre nil :steps
                ("Нажать «Войти» и пройти единый вход" "Дождаться окончания проверки.")
                :expected
                "Экран выбора роли не показывается, сразу открывается кабинет назначенной роли. Данные 1: «Оперативный дашборд», в шапке выбрано «Все мои направления». Данные 2: раздел «Личный кабинет» с заголовком «Личный кабинет оператора», в боковом меню активен пункт «Личный кабинет».")
            (:n 2 :name "Действие смены роли не показывается учётной записи с одной ролью"

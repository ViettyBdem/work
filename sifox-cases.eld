          ("DICT-018" :id "DICT-018" :module "Справочники" :screen
           "Предупреждение о несохранённых изменениях" :title
           "Уход из раздела с несохранёнными правками: «Остаться», «Не сохранять», «Сохранить и перейти»"
           :priority "High" :kind "Функциональный" :mode chain :pre
           "Пользователь с ролью «Технический администратор» вошёл в кабинет тех.админа. Открыт раздел «Справочники»."
           :parts
           ((:n 1 :name "Уход из раздела с несохранёнными правками" :pre nil :steps
                ("Выключить «Онлайн»" "Кликнуть пункт меню «Роли»") :expected
                "Переход не выполняется; модальное окно «НЕСОХРАНЁННЫЕ ИЗМЕНЕНИЯ» с текстом «В справочниках есть несохранённые изменения. Сохранить их перед переходом?» и кнопками «Остаться», «Не сохранять» (красная обводка), «Сохранить и перейти» (синяя), «✕».")
            (:n 2 :name "«Остаться» сохраняет правки на экране" :pre
                "Выключен «Онлайн», открыто окно «Несохранённые изменения»." :steps
                ("Кликнуть «Остаться»") :expected
                "Окно закрывается, остаётся раздел «Справочники», «Онлайн» выключен, надпись «Есть несохранённые изменения — …». Так же ведут себя «✕» и клик по затемнённому фону.")
            (:n 3 :name "«Не сохранять» откатывает и переходит" :pre
                "Выключен «Онлайн», окно вызвано кликом по «Роли»." :steps
                ("Кликнуть «Не сохранять»" "Вернуться в «Справочники»") :expected
                "Открывается раздел «Роли» без тоста; в «Справочниках» «Онлайн» снова включён, надпись «Все изменения сохранены».")
            (:n 4 :name "«Сохранить и перейти»" :pre
                "Выключен «Онлайн», окно вызвано кликом по «Роли»." :steps
                ("Кликнуть «Сохранить и перейти»") :expected
                "Появляется тост «Изменения сохранены» («Обновлено справочников: 1. …»), открывается раздел «Роли»; при возврате «Онлайн» выключен, «Все изменения сохранены»."))
